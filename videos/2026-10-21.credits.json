      "Artist": {
        "value": "<bdi><a href=\"https://en.wikipedia.org/wiki/en:J._M._W._Turner\" class=\"extiw\" title=\"w:en:J. M. W. Turner\"><span title=\"English painter and draftsman (c.1775–1851)\">J. M. W. Turner</span></a></bdi>",
